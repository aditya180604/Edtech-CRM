# MongoDB Atlas Configuration
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/?appName=Cluster0
DATABASE_NAME=edutech_db

# Server Configuration
PORT=5000
NODE_ENV=development

# JWT & Authentication Secrets
JWT_SECRET=your_jwt_access_secret_key_here
JWT_EXPIRES_IN=15m
JWT_REFRESH_SECRET=your_jwt_refresh_secret_key_here
JWT_REFRESH_EXPIRES_IN=7d

# CORS Configuration
CORS_ORIGIN=http://localhost:5173

# Super Admin Initial Credentials (Optional for Bootstrap)
SUPER_ADMIN_EMAIL=superadmin@edutech.com
SUPER_ADMIN_PASSWORD=YourStrongPassword123!
SUPER_ADMIN_FIRSTNAME=Super
SUPER_ADMIN_LASTNAME=Admin

# Google Gemini / AI Copilot API Key
GEMINI_API_KEY=your_gemini_api_key_here
